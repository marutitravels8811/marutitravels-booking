# Neon — copy the *pooled* connection string from the Neon console
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# 32+ random chars: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# How long a reservation is held before the seats return to the pool.
# Agents can park a reservation and confirm it later, so this needs to cover a
# customer going away to arrange payment. Two extensions are allowed on top.
HOLD_TTL_MINUTES=30

# Office timezone for service dates and reports
OFFICE_TIMEZONE="Asia/Kolkata"

# Secret for the cron endpoint that sweeps expired holds
CRON_SECRET="change-me-too"

# ── What gets printed at the top of every ticket ──
OFFICE_NAME="Maruti Travels"
OFFICE_TAGLINE=""
OFFICE_PHONE="+91 98765 43210"
OFFICE_ALT_PHONE=""
OFFICE_ADDRESS="Bus Stand Road, Rajkot 360001"
OFFICE_EMAIL=""
OFFICE_GSTIN=""
# Terms printed at the foot of a ticket, separated by |
OFFICE_TERMS="Report 15 min before departure|Carry photo ID|Non-transferable"
